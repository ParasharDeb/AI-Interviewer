generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User{
  id          String            @id @default(uuid())
  username    String
  password    String
  email       String            @unique
  tokens      Int               @default(3)
  Interview   Interview[]
}
model Interview{
  id                String      @id  @default(uuid())
  githubmetadata    Json
  status            InterviewStatus
  score             Int         @default(0)
  feedback          String      @default("")
  messages          Messages[]
  userID            String      
  User              User        @relation(fields: [userID],references: [id])
}
model Messages{
  id          String            @id @default(uuid())
  messages    String
  type        MessagesType
  interviewid String
  interview   Interview         @relation(fields: [interviewid],references: [id])
  sentAt      DateTime          
}
enum MessagesType{
  User
  AIassistent
}
enum InterviewStatus{
  Pre 
  Inprocess
  Marking
  Ended
}